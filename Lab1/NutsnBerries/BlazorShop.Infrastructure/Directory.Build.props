<Project>
  <!--
    Temporary security pin for a transitive package with known vulnerabilities (NuGet audit NU1902/NU1903).
    Remove this file once MimeKit (via MailKit) ships a dependency on a fixed System.Security.Cryptography.Pkcs.

    Lives in this project folder, not at the solution root, because the Dockerfiles copy only project folders:
    a root-level Directory.Build.props would never reach the container builds.
    Projects that reference BlazorShop.Infrastructure (API, Tests, E2E) inherit the pinned version.
  -->
  <ItemGroup>
    <!-- GHSA-846f-f764-76mx (high), GHSA-2fmv-rv2c-59x7 (moderate); fixed in 10.0.13. Comes in via MailKit > MimeKit. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
