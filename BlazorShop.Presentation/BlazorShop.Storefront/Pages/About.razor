@page "/about-us"
@inject IStorefrontSeoComposer SeoComposer
@inject IStorefrontStructuredDataComposer StructuredDataComposer

<SeoHead Metadata="_metadata" StructuredData="_structuredData" />

<section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="rounded-2xl bg-white/80 p-6 shadow sm:p-8">
        <header class="text-center">
            <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900">About NutsnBerries</h1>
            <p class="mt-4 text-base leading-7 text-neutral-700">
                NutsnBerries makes natural beauty products inspired by the forest floor: cold-pressed nut oils, wild berry extracts and gentle botanicals for skin, hair and body.
            </p>
        </header>

        <div class="mt-8 grid gap-6 md:grid-cols-2">
            <div class="rounded-2xl border border-neutral-200 bg-white/70 p-6">
                <h2 class="text-lg font-bold text-neutral-900">Our ingredients</h2>
                <p class="mt-3 text-sm leading-6 text-neutral-700">
                    We start with nuts, berries and plants, and keep the ingredient lists short and honest. Everything we sell is chosen because it is kind to your skin and to the places it comes from.
                </p>
            </div>
            <div class="rounded-2xl border border-neutral-200 bg-white/70 p-6">
                <h2 class="text-lg font-bold text-neutral-900">Our promise</h2>
                <p class="mt-3 text-sm leading-6 text-neutral-700">
                    No harsh additives and no animal testing. We favour recyclable packaging and fair sourcing, so you can feel good about what you put on your skin.
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private SeoMetadataDto _metadata = new();
    private StorefrontStructuredDataDocument _structuredData = StorefrontStructuredDataDocument.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var metadataTask = SeoComposer.ComposeStaticPageAsync(
            "About Us",
            StorefrontRoutes.About,
            "Learn about NutsnBerries, our natural ingredients and our promise to you.");
        var structuredDataTask = StructuredDataComposer.ComposeWebPageAsync(
            "About Us",
            StorefrontRoutes.About,
            "Learn about NutsnBerries, our natural ingredients and our promise to you.");

        await Task.WhenAll(metadataTask, structuredDataTask);

        _metadata = await metadataTask;
        _structuredData = await structuredDataTask;
    }
}